{
    "experimentalServices": {
        "frontend": {
            "root": "frontend",
            "routePrefix": "/",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "routePrefix": "/_/backend",
            "builder": "@vercel/python",
            "entrypoint": "imglab_api/main.py"
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/_/backend/api/$1" }
    ]
}
